        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="colunas_para_remover = [&quot;thisN&quot;, &quot;thisTrialN&quot;, &quot;thisRepN&quot;, &quot;mouse_response_trial.x&quot;, &quot;mouse_response_trial.y&quot;, &quot;mouse_response_trial.leftButton&quot;, &quot;mouse_response_trial.midButton&quot;, &quot;mouse_response_trial.rightButton&quot;, &quot;mouse_response_trial.time&quot;, &quot;mouse_response_trial.clicked_name&quot;, &quot;introTrials.thisRepN&quot;, &quot;introTrials.thisTrialN&quot;, &quot;introTrials.thisN&quot;, &quot;introTrials.thisIndex&quot;, &quot;block1Trials.thisRepN&quot;, &quot;block1Trials.thisTrialN&quot;, &quot;block1Trials.thisN&quot;, &quot;block1Trials.thisIndex&quot;, &quot;thisRow.t&quot;, &quot;notes&quot;, &quot;piloting&quot;, &quot;block1Trials.mouse_response_trial.x&quot;, &quot;block1Trials.mouse_response_trial.y&quot;, &quot;block1Trials.mouse_response_trial.leftButton&quot;, &quot;block1Trials.mouse_response_trial.midButton&quot;, &quot;block1Trials.mouse_response_trial.rightButton&quot;, &quot;block1Trials.mouse_response_trial.time&quot;, &quot;block1Trials.mouse_response_trial.clicked_name&quot;];&amp;#10;for (var linha, _pj_c = 0, _pj_a = psychoJS.experiment.entries, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    linha = _pj_a[_pj_c];&amp;#10;    for (var coluna, _pj_f = 0, _pj_d = colunas_para_remover, _pj_e = _pj_d.length; (_pj_f &lt; _pj_e); _pj_f += 1) {&amp;#10;        coluna = _pj_d[_pj_f];&amp;#10;        linha.splice(colunaNone, 1);&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Lista com o nome exato das colunas que você quer ELIMINAR da planilha&amp;#10;colunas_para_remover = [&amp;#10;    'thisN', 'thisTrialN', 'thisRepN',&amp;#10;    'mouse_response_trial.x', 'mouse_response_trial.y',&amp;#10;    'mouse_response_trial.leftButton', 'mouse_response_trial.midButton',&amp;#10;    'mouse_response_trial.rightButton', 'mouse_response_trial.time',&amp;#10;    'mouse_response_trial.clicked_name',&amp;#10;    'introTrials.thisRepN', 'introTrials.thisTrialN', 'introTrials.thisN', 'introTrials.thisIndex',&amp;#10;    'block1Trials.thisRepN', 'block1Trials.thisTrialN', 'block1Trials.thisN', 'block1Trials.thisIndex',&amp;#10;    'thisRow.t', 'notes', 'piloting',&amp;#10;    'block1Trials.mouse_response_trial.x', 'block1Trials.mouse_response_trial.y',&amp;#10;    'block1Trials.mouse_response_trial.leftButton', 'block1Trials.mouse_response_trial.midButton',&amp;#10;    'block1Trials.mouse_response_trial.rightButton', 'block1Trials.mouse_response_trial.time',&amp;#10;    'block1Trials.mouse_response_trial.clicked_name'&amp;#10;]&amp;#10;&amp;#10;# Varre todas as linhas registradas e deleta as colunas indesejadas&amp;#10;for linha in thisExp.entries:&amp;#10;    for coluna in colunas_para_remover:&amp;#10;        linha.pop(coluna, None)  # Remove a coluna se ela existir" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="True" valType="bool" updates="None" name="disabled"/>
