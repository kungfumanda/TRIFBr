  <Flow>
    <Routine name="welcomeRoutine"/>
    <LoopInitiator loopType="TrialHandler" name="introTrials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('Bloco', 'BT'), ('Condicao', 'INTRO'), ('Lamina_ID', 'LT'), ('Target_Correto_Posicao', np.int64(4)), ('Target_Pasta_Frames', '../stimuli/BT/frames_Face_Alvo_Teste'), ('Image_1', '../stimuli/BT/Daiane.png'), ('Image_2', '../stimuli/BT/Mariana.png'), ('Image_3', '../stimuli/BT/Julia.png'), ('Image_4', '../stimuli/BT/Aline (alvo).png')])]" valType="str"/>
