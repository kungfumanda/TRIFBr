      <CodeComponent name="code_handle_trial" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="identificator = (Bloco + Lamina_ID);&amp;#10;correct_pos = Target_Correto_Posicao.toString();&amp;#10;correct_response_name = (&quot;stim_image_&quot; + correct_pos);&amp;#10;is_correct = 0;&amp;#10;rt_value = null;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Sets the ID Variable&amp;#10;identificator = Bloco+Lamina_ID&amp;#10;# Mapeia a posição numérica (lida do CSV) para o nome do componente visual&amp;#10;correct_pos = str(Target_Correto_Posicao) &amp;#10;# Cria o nome do componente de imagem que é a resposta correta&amp;#10;correct_response_name = 'stim_image_' + correct_pos&amp;#10;&amp;#10;# Inicializa variáveis para este trial&amp;#10;is_correct = 0&amp;#10;rt_value = None&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="response_method = &quot;miss&quot;;&amp;#10;selected_option = null;&amp;#10;if ((key_response_trial.keys.length &gt; 0)) {&amp;#10;    response_method = &quot;keyboard&quot;;&amp;#10;    rt_value = key_response_trial.rt;&amp;#10;    pressed_key = key_response_trial.keys[0];&amp;#10;    if ((pressed_key.toString() === Target_Correto_Posicao.toString())) {&amp;#10;        is_correct = 1;&amp;#10;    }&amp;#10;    selected_option = `stim_image_${pressed_key}`;&amp;#10;} else {&amp;#10;    if (mouse_response_trial.clicked_name) {&amp;#10;        response_method = &quot;mouse&quot;;&amp;#10;        if (((mouse_response_trial.time !== null) &amp;&amp; (mouse_response_trial.time.length &gt; 0))) {&amp;#10;            rt_value = mouse_response_trial.time[0];&amp;#10;        }&amp;#10;        selected_option = mouse_response_trial.clicked_name[0];&amp;#10;        if ((selected_option === correct_response_name)) {&amp;#10;            is_correct = 1;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;ANALYSIS_Lamina_ID&quot;, identificator);&amp;#10;psychoJS.experiment.addData(&quot;ANALYSIS_CR&quot;, is_correct);&amp;#10;psychoJS.experiment.addData(&quot;ANALYSIS_RT&quot;, util.round(rt_value, 3));&amp;#10;psychoJS.experiment.addData(&quot;ANALYSIS_Response_Method&quot;, response_method);&amp;#10;psychoJS.experiment.addData(&quot;ANALYSIS_Selected_Option&quot;, selected_option);&amp;#10;psychoJS.experiment.addData(&quot;ANALYSIS_Target_Component&quot;, correct_response_name);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Inicializar as variáveis de análise (default: miss/sem resposta)&amp;#10;response_method = 'miss'&amp;#10;selected_option = None&amp;#10;&amp;#10;#  Arbitragem de Resposta:&amp;#10;&amp;#10;# Checa se houve resposta pelo Teclado&amp;#10;if len(key_response_trial.keys) &gt; 0:&amp;#10;    &amp;#10;    response_method = 'keyboard'&amp;#10;    rt_value = key_response_trial.rt&amp;#10;    &amp;#10;    # Pega o primeiro dígito pressionado&amp;#10;    pressed_key = key_response_trial.keys[0] &amp;#10;    &amp;#10;    # Checa o acerto&amp;#10;    if str(pressed_key) == str(Target_Correto_Posicao):&amp;#10;        is_correct = 1&amp;#10;    &amp;#10;    selected_option = f&quot;stim_image_{pressed_key}&quot;&amp;#10;&amp;#10;# Se não, checa se houve resposta pelo Mouse&amp;#10;elif mouse_response_trial.clicked_name:&amp;#10;    &amp;#10;    response_method = 'mouse'&amp;#10;    &amp;#10;    # O tempo do mouse está na lista de tempos registrada pelo componente&amp;#10;    if mouse_response_trial.time is not None and len(mouse_response_trial.time) &gt; 0:&amp;#10;        rt_value = mouse_response_trial.time[0]&amp;#10;    &amp;#10;    # O nome do componente clicado está na lista&amp;#10;    selected_option = mouse_response_trial.clicked_name[0] &amp;#10;    &amp;#10;    # Checa o acerto&amp;#10;    if selected_option == correct_response_name:&amp;#10;        is_correct = 1&amp;#10;&amp;#10;# SALVAR APENAS AS COLUNAS ESSENCIAIS NO ARQUIVO FINAL&amp;#10;thisExp.addData('ANALYSIS_Lamina_ID', (identificator))&amp;#10;thisExp.addData('ANALYSIS_CR', is_correct)&amp;#10;thisExp.addData('ANALYSIS_RT', (round(rt_value,3)))&amp;#10;thisExp.addData('ANALYSIS_Response_Method', response_method)&amp;#10;thisExp.addData('ANALYSIS_Selected_Option', selected_option)&amp;#10;thisExp.addData('ANALYSIS_Target_Component', correct_response_name)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_handle_trial" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="targetID_Teste" plugin="None">
